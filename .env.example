# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local SQLite; set in production to a PostgreSQL connection URL.
DATABASE_URL=

# Celery/Redis (introduced for asynchronous extraction in later phases)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Server-side LLM extraction only; never expose this value in the browser.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Larger batches reduce API round trips; keep within the model context window.
EXTRACTION_BLOCK_BATCH_SIZE=80
# Parallel independent batches; keep small to avoid API rate limits.
EXTRACTION_MAX_CONCURRENCY=3

# Optional first Django admin account. Supply all three only in deployment settings.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
